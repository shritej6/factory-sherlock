# Copy this file to .env and adjust the values. Never commit .env.

# MySQL connection used by the backend and by Alembic migrations.
# The application connects as a least-privilege user, not as root.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=factory_sherlock
MYSQL_USER=sherlock_app
MYSQL_PASSWORD=change-me

# Root password used only by setup scripts and docker-compose to create the
# database and the application user. Not read by the application itself.
MYSQL_ROOT_PASSWORD=change-me-root

# Secret used to sign JWT access tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ACCESS_TOKEN_MINUTES=120

# Login throttle. After LOGIN_MAX_FAILURES failed attempts for one username or
# one client address within LOGIN_WINDOW_SECONDS, login returns 429 until the
# oldest failure leaves the window. Counted in memory per API process.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900

# Password assigned to the seeded demonstration accounts (admin, engineer,
# operator, viewer). Development only.
SEED_DEMO_PASSWORD=change-me-demo

# Comma separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

# Set to "test" when running the backend test suite so it uses the
# factory_sherlock_test database and never touches development data.
APP_ENV=development
LOG_LEVEL=INFO
